node_modules/
dist/
*.local
.DS_Store
.vite/
coverage/
tsconfig.tsbuildinfo

# §4.7 validation replies: named testers joined to declared votes and full
# answer vectors. Never commit these. BRIEF.md is the exception and is forced in.
validation/*
!validation/BRIEF.md

# Local D1 state from `wrangler dev --local`: holds a SQLite database
# with whatever test payloads were posted through it.
server/.wrangler/

# Output of scripts/smoke-payload.ts. Synthetic and harmless, but regenerating
# it is one command and a committed copy would go stale against the item bank
# the moment an item is added — which is exactly the drift the smoke test exists
# to catch.
payload.json
